   "start": 12.427,
   "voice_len": 8.046,
   "end": 20.473
  },
  {
   "id": "04",
   "text": "ついた のはらわ、からから。おはなが、げんきなく、うつむいて いた。",
   "speed": 0.8,
   "start": 21.973,
   "voice_len": 8.661,
   "end": 30.634
  },
  {
   "id": "05",
   "text": "あめに なったら、ぼくわ、ちいさく なっちゃう。モコわ、すこし まよった。",
   "speed": 0.8,
   "start": 32.134,
   "voice_len": 8.951,
   "end": 41.085
  },
  {
   "id": "06",
   "text": "でも、<break time=\"0.8s\" />ぼくが、あめに なる!",
