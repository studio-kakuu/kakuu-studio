{
  "extraKnownMarketplaces": {
    "lemolab": {
      "source": {
        "source": "github",
        "repo": "lemomo-ai/lemo-opuscar"
      }
    }
  },
  "enabledPlugins": {
    "lemo-opuscar@lemolab": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lemo-opuscar-setup.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
