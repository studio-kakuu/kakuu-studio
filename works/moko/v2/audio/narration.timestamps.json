   "start": 3.462,
   "voice_len": 6.478,
   "end": 9.94
  },
  {
   "id": "03",
   "text": "ある ひ、ビューッと かぜが ふいて、モコわ、とおくえ、とばされた。",
   "speed": 0.9,
   "start": 11.44,
   "voice_len": 7.198,
   "end": 18.638
  },
  {
   "id": "04",
   "text": "ついた のはらわ、からから。おはなが、げんきなく、うつむいて いた。",
   "speed": 0.9,
   "start": 20.138,
   "voice_len": 7.93,
   "end": 28.068
  },
  {
   "id": "05",
   "text": "あめに なったら、ぼくわ、ちいさく なっちゃう。モコわ、すこし まよった。",
   "speed": 0.9,
   "start": 29.568,
   "voice_len": 8.545,
   "end": 38.113
  },
  {
   "id": "06",
   "text": "でも、<break time=\"0.8s\" />ぼくが、あめに なる!",
   "speed": 0.9,
   "start": 39.613,
   "voice_len": 3.622,
   "end": 43.235
  },
  {
   "id": "07a",
   "text": "ぽつ、ぽつ、ぽつ。",
   "speed": 0.95,
   "start": 44.735,
   "voice_len": 1.892,
   "end": 46.627
  },
  {
   "id": "07b",
   "text": "モコわ、あめに なって、ふった。",
   "speed": 0.9,
   "start": 47.827,
   "voice_len": 3.158,
   "end": 50.985
  },
  {
   "id": "08",
